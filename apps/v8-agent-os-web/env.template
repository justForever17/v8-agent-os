# V8 Agent OS Web
# Copy this file to .env.local.
# These values only boot the Web app. System truth stays in ~/.v8chat/config.json.

# Session URL for this Web app
NEXTAUTH_URL="http://127.0.0.1:9527"

# Session secret used by NextAuth/Auth.js
NEXTAUTH_SECRET="replace-this-with-a-long-random-secret"

# Optional: allow the browser to connect to Engine WebSocket directly.
# Leave this false unless you know you need direct WebSocket access.
NEXT_PUBLIC_V8_AGENT_OS_ENABLE_DIRECT_ENGINE_WS="false"
