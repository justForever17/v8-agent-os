{
  "name": "@v8/product-ui",
  "private": true,
  "version": "0.0.13",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./theme-bootstrap": {
      "types": "./dist/product-theme-bootstrap.d.ts",
      "default": "./dist/product-theme-bootstrap.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "clean": "if exist dist rmdir /s /q dist && if exist styles.css del styles.css",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "next-themes": ">=0.4.6",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next-themes": "^0.4.6",
    "typescript": "^5.9.2"
  }
}
