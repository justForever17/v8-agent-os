# V8 Agent OS Admin
# Copy this file to .env.local.
# These values only boot the Admin console. Runtime truth stays in ~/.v8chat/config.json.

# Public URL of this Admin console
NEXTAUTH_URL="http://localhost:9528"

# Trust localhost / 127.0.0.1 hosts for local desktop admin auth flows
AUTH_TRUST_HOST="true"

# Session secret used by NextAuth/Auth.js
NEXTAUTH_SECRET="replace-this-with-a-long-random-secret"

# Optional: show a custom version badge in the UI
NEXT_PUBLIC_APP_VERSION="1.0.0"
