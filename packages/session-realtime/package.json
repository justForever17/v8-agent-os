    "verify:message-bound-execution": "npm run build && node scripts/verify-message-bound-execution-node.mjs",
    "verify:history": "npm run build && node scripts/verify-history-grouping.mjs",
    "verify:resources": "npm run build && node scripts/verify-admin-resource-url.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
