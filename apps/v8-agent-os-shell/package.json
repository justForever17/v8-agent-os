{
  "name": "v8-agent-os-shell",
  "private": true,
  "version": "2026.8.24-3",
  "description": "V8 Agent OS desktop preview shell",
  "author": {
    "name": "V8 Agent OS",
    "email": "justforever17@users.noreply.github.com"
  },
  "desktopName": "v8-agent-os.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/justForever17/v8-agent-os.git"
  },
  "main": "electron/bootstrap.cjs",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "electron:start": "node scripts/launch-shell.mjs",
    "dist:win": "npm run dist:win:preview",
    "dist:win:preview": "cross-env ELECTRON_BUILDER_7Z_FILTER=BCJ electron-builder --config electron-builder.yml --win nsis --publish never",
    "dist:win:stable": "cross-env ELECTRON_BUILDER_7Z_FILTER=BCJ electron-builder --config electron-builder.yml --win nsis zip --publish never",
    "dist:mac:preview": "electron-builder --config electron-builder.yml --mac dmg --publish never",
    "dist:linux:preview": "electron-builder --config electron-builder.yml --linux AppImage deb --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  }
}
