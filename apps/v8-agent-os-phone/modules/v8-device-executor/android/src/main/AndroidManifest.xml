<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <service android:name=".ExecutorAccessibilityService" android:label="@string/v8_executor_name"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/v8_executor_accessibility" />
    </service>
    <receiver android:name=".ExecutorStopReceiver" android:exported="false" />
  </application>
</manifest>
